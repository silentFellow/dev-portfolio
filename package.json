{
  "name": "dev-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky",
    "test": "node --test lib/*.test.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "playwright": "^1.65.1",
    "typescript": "^5"
  }
}
